      "finding": "effective controller changes; posterior moves; in loss scenario greedy behavior changed"
    },
    {
      "stage": "v5",
      "config": "4 MiB six-mode unified benchmark, 300 runs",
      "finding": "periodic LinUCB coverage in one campaign; scenario-dependent"
    },
    {
      "stage": "wall-clock infrastructure",
      "config": "server RateSchedule (time-based transition)",
      "finding": "transition at fixed elapsed time independent of request count"
    },
    {
      "stage": "v6",
      "config": "wall-clock throttle 512KiB/s -> 4MiB/s after 1 s, 60 runs",
      "finding": "periodic LinUCB sustains concurrency ~3.9; standard still locks"
    },
    {
      "stage": "aria2 old throttle",
      "config": "aria2 1.37.0, request-count throttle, 50 runs",
      "finding": "4 x 1 MiB requests; request-count transition never benefits aria2"
    },
    {
      "stage": "granularity study",
      "config": "internal 1 MiB/4C vs aria2, old throttle",
      "finding": "matched internal closely reproduces aria2 in 4/5 scenarios"
    },
    {
      "stage": "aria2 wall-clock",
      "config": "aria2 under wall-clock throttle, 10 runs",
      "finding": "all 4 large requests begin before 1 s; none reaches 4 MiB/s"
    },
    {
      "stage": "wall-clock matched control",
      "config": "internal 1 MiB/4C under wall-clock throttle, 10 runs",
